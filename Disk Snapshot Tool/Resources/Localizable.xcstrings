{
  "sourceLanguage" : "en",
  "strings" : {
    "\"%@\" cannot be reached." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» ist nicht erreichbar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» no está accesible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » est inaccessible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» non è raggiungibile."
          }
        }
      }
    },
    "\"%@\" contains disk images that are already listed on their own. Remove them from the list first." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» enthält Disk-Images, die bereits einzeln in der Liste stehen. Entfernen Sie diese zuerst aus der Liste."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» contiene imágenes de disco que ya figuran por separado en la lista. Quítelas primero de la lista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » contient des images disque qui figurent déjà individuellement dans la liste. Retirez-les d’abord de la liste."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» contiene immagini disco già presenti singolarmente nell’elenco. Rimuoverle prima dall’elenco."
          }
        }
      }
    },
    "\"%@\" could not be added: %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» konnte nicht hinzugefügt werden: %@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "\"%1$@\" could not be added: %2$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo añadir «%@»: %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » n’a pas pu être ajouté : %@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile aggiungere «%@»: %@"
          }
        }
      }
    },
    "\"%@\" could not be read by qemu-img, so it was not added." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» konnte von qemu-img nicht gelesen werden und wurde deshalb nicht hinzugefügt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "qemu-img no pudo leer «%@», por lo que no se ha añadido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » n’a pas pu être lu par qemu-img et n’a donc pas été ajouté."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "qemu-img non è riuscito a leggere «%@», quindi non è stato aggiunto."
          }
        }
      }
    },
    "\"%@\" is neither a disk image nor a UTM virtual machine." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» ist weder ein Disk-Image noch eine virtuelle UTM-Maschine."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» no es ni una imagen de disco ni una máquina virtual de UTM."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » n’est ni une image disque ni une machine virtuelle UTM."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» non è né un’immagine disco né una macchina virtuale UTM."
          }
        }
      }
    },
    "\"%@\" will be removed from the sidebar. The file on disk is not affected." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» wird aus der Seitenleiste entfernt. Die Datei selbst bleibt unverändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» se quitará de la barra lateral. El archivo en el disco no se verá afectado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » sera retiré de la barre latérale. Le fichier sur le disque n’est pas modifié."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» verrà rimosso dalla barra laterale. Il file sul disco non viene modificato."
          }
        }
      }
    },
