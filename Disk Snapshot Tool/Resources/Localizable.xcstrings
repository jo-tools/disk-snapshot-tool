    "Internal snapshots are a feature of the qcow2 format; %@ images cannot store them. This disk can be inspected here, but not snapshotted." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interne Snapshots sind eine Funktion des qcow2-Formats; Images im Format %@ können sie nicht speichern. Diese Disk lässt sich hier ansehen, aber keine Snapshots davon erstellen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las instantáneas internas son una función del formato qcow2; las imágenes en formato %@ no pueden almacenarlas. Este disco puede consultarse aquí, pero no admite instantáneas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les instantanés internes sont une fonctionnalité du format qcow2 ; les images au format %@ ne peuvent pas en contenir. Ce disque peut être consulté ici, mais aucun instantané ne peut en être créé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le istantanee interne sono una funzione del formato qcow2; le immagini in formato %@ non possono contenerle. Questo disco può essere esaminato qui, ma non supporta istantanee."
          }
        }
      }
    },
