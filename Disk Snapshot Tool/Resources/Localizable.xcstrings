    "Applying \"%@\" will overwrite the current live state of the disk. This cannot be undone unless you create another snapshot first." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Anwenden von «%@» überschreibt den aktuellen Zustand der Disk. Dies lässt sich nicht rückgängig machen, ausser Sie erstellen zuvor einen weiteren Snapshot."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplicar «%@» sobrescribirá el estado actual del disco. No se puede deshacer, a menos que cree antes otra instantánea."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appliquer « %@ » écrasera l’état actuel du disque. Cette opération est irréversible, à moins de créer d’abord un autre instantané."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applicando «%@» verrà sovrascritto lo stato attuale del disco. L’operazione non può essere annullata, a meno di creare prima un’altra istantanea."
          }
        }
      }
    },
