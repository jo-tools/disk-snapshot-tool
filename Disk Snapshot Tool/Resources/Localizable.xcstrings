    "An older snapshot is also named \"%@\", and qemu-img would delete that one instead.\nDelete the older one first." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein älterer Snapshot heisst ebenfalls «%@», und qemu-img würde stattdessen diesen löschen.\nLöschen Sie zuerst den älteren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una instantánea más antigua también se llama «%@», y qemu-img eliminaría esa en su lugar.\nElimine primero la más antigua."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un instantané plus ancien s’appelle aussi « %@ », et qemu-img supprimerait celui-là à la place.\nSupprimez d’abord le plus ancien."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anche un’istantanea più vecchia si chiama «%@» e qemu-img eliminerebbe quella al suo posto.\nEliminare prima quella più vecchia."
          }
        }
      }
    },
