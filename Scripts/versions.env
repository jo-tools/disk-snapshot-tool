# versions.env — pinned third-party sources for the bundled qemu-img.
#
# Every SHA256 below was cross-checked against an independent publisher
# (upstream's own checksum file, or Homebrew's pinned value) — not merely
# computed from whatever the download returned. Re-verify when bumping.
#
# This file is part of the GPLv2 §3 "scripts used to control compilation"
# obligation: together with build-qemu-img.sh it fully determines the
# qemu-img binary we ship. Do not edit casually.
#
# Changing any value here changes the build cache key and forces a rebuild.

# QEMU — the only reason any of this exists.
# NOTE: 11.1.1's configure requires Python >= 3.9. The build uses Xcode's
# /usr/bin/python3 (3.9.6 as of Xcode 27). Newer QEMU raises the minimum (master
# wants >= 3.12), so check a bump against the Python the current Xcode ships.
QEMU_VERSION="11.1.1"
QEMU_URL="https://download.qemu.org/qemu-${QEMU_VERSION}.tar.xz"
QEMU_SHA256="079ffbff8a7111bbc89022107cbabf3bbfd614d5fc9d7cc675991196aca12482"

# glib — qemu-img's only hard third-party dependency (>= 2.66).
# Its meson wraps supply pcre2, libffi and proxy-libintl, so we don't build those.
GLIB_VERSION="2.88.0"
GLIB_URL="https://download.gnome.org/sources/glib/2.88/glib-${GLIB_VERSION}.tar.xz"
GLIB_SHA256="3546251ccbb3744d4bc4eb48354540e1f6200846572bab68e3a2b7b2b64dfd07"

# zstd — optional, but needed to read qcow2 images with compression_type=zstd.
ZSTD_VERSION="1.5.7"
ZSTD_URL="https://github.com/facebook/zstd/releases/download/v${ZSTD_VERSION}/zstd-${ZSTD_VERSION}.tar.gz"
ZSTD_SHA256="eb33e51f49a15e023950cd7825ca74a4a2b43db8354825ac24fc1b7ee09e6fa3"

# pkgconf — build tool only; macOS ships no pkg-config and meson needs one
# to resolve dependency('glib-2.0'). Not linked into the product.
PKGCONF_VERSION="3.0.7"
PKGCONF_URL="https://distfiles.ariadne.space/pkgconf/pkgconf-${PKGCONF_VERSION}.tar.xz"
PKGCONF_SHA256="c926ff491cbd9a331a589160811bd97ab1749b4d5198a519338f2cdfabe6940a"

# ninja — build tool only. QEMU's configure hard-errors without it.
# Bootstrapped from source via configure.py (needs only clang++), which keeps
# every input checksum-pinned instead of pulling an unpinned wheel from PyPI.
NINJA_VERSION="1.13.2"
NINJA_URL="https://github.com/ninja-build/ninja/archive/refs/tags/v${NINJA_VERSION}.tar.gz"
NINJA_SHA256="974d6b2f4eeefa25625d34da3cb36bdcebe7fbce40f4c16ac0835fd1c0cbae17"

# meson is NOT listed here: QEMU vendors a pinned wheel in python/wheels/
# (pythondeps.toml pins 1.11.1). We install that into a venv, so meson's
# version is already determined by QEMU_VERSION above.

# Oldest macOS the bundled qemu-img must run on.
#
# Kept equal to the app's own MACOSX_DEPLOYMENT_TARGET on purpose. The helper is
# signed with com.apple.security.inherit and cannot run outside this app, so a
# lower target buys nothing — and it actively costs: every API the SDK declares
# above this version is weak-imported and resolves to NULL at runtime, which is
# a segfault rather than an error. At 11.0 that silently applied to QEMU's own
# use of IOMainPort() (macOS 12+) in block/file-posix.c.
#
# Raise this in step with the app's deployment target, never below it.
QEMU_IMG_MACOS_MIN="26.0"

# tomli — pure-Python TOML parser, build-time only (not linked into anything).
#
# QEMU's configure parses pythondeps.toml with tomllib, which only exists in
# Python 3.11+. Xcode's Python is older, and QEMU does not vendor a tomli wheel,
# so configure dies with "found no usable tomli". We install this pinned wheel
# into our own venv and point configure at it via --python. Drop this once the
# build uses a Python >= 3.11.
TOMLI_VERSION="2.2.1"
TOMLI_URL="https://files.pythonhosted.org/packages/6e/c2/61d3e0f47e2b74ef40a68b9e6ad5984f6241a942f7cd3bbfbdbd03861ea9/tomli-${TOMLI_VERSION}-py3-none-any.whl"
TOMLI_SHA256="cb55c73c5f4408779d0cf3eef9f762b9c9f147a77de7b258bef0a5628adc85cc"
